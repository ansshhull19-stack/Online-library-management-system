# Database Connection Configuration Template
# Copy this file to 'db.properties' and fill in your actual MySQL credentials.
# 'db.properties' is ignored by .gitignore to prevent committing passwords.

db.url=jdbc:mysql://localhost:3306/library_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
db.username=root
db.password=YOUR_MYSQL_PASSWORD_HERE
db.driver=com.mysql.cj.jdbc.Driver

# Connection Pool Settings
db.pool.maxTotal=20
db.pool.maxIdle=10
db.pool.minIdle=2
db.pool.maxWaitMillis=10000
